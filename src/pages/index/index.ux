<template>
  <div class="root" style="background-color: {{t.bg}}">
  <swiper class="pager" index="{{current}}" indicator="false" onchange="onPageChange">
    <!-- 1. Readiness -->
    <div class="screen" style="background-color: {{t.bg}}">
      <div class="head">
        <text class="head-label" style="color: {{t.accent}}">Readiness</text>
        <text class="head-time" style="color: {{t.ink}}">{{time}}</text>
      </div>
      <stack class="ring-box">
        <progress class="arc" type="arc" percent="{{readiness.score}}" style="color: {{t.accent}}; background-color: {{t.track}}; stroke-width: 22px; start-angle: 225; total-angle: 270; center-x: 140px; center-y: 140px; radius: 118px"></progress>
        <div class="ring-center">
          <text class="score" style="color: {{t.ink}}">{{readiness.score}}</text>
          <text class="unit" style="color: {{t.muted}}">of 100</text>
        </div>
      </stack>
      <text class="caption" style="color: {{t.ink}}">{{readiness.note}}</text>
    </div>

    <!-- 2. Sleep -->
    <div class="screen" style="background-color: {{t.bg}}">
      <div class="head">
        <text class="head-label" style="color: {{t.accent}}">Sleep</text>
        <text class="head-time" style="color: {{t.ink}}">{{time}}</text>
      </div>
      <div class="sleep-body">
        <text class="big" style="color: {{t.ink}}">{{sleep.total}}</text>
        <text class="sub" style="color: {{t.muted}}">{{sleep.window}}</text>
        <div class="bars">
          <div for="{{sleepBars}}" class="bar" style="height: {{$item.h}}px; background-color: {{$item.c}}"></div>
        </div>
        <div class="legend">
          <div class="legend-item">
            <div class="swatch" style="background-color: {{t.accent}}"></div>
            <text class="legend-text" style="color: {{t.muted}}">Deep {{sleep.deep}}</text>
          </div>
          <div class="legend-item">
            <div class="swatch" style="background-color: {{t.sleepRem}}"></div>
            <text class="legend-text" style="color: {{t.muted}}">REM {{sleep.rem}}</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Heart -->
    <div class="screen" style="background-color: {{t.bg}}">
      <div class="head">
        <text class="head-label" style="color: {{t.accent}}">Heart</text>
        <text class="head-time" style="color: {{t.ink}}">{{time}}</text>
      </div>
      <div class="heart-body">
        <div class="bpm-row">
          <text class="big" style="color: {{t.ink}}">{{heart.bpm}}</text>
          <text class="bpm-unit" style="color: {{t.muted}}">bpm now</text>
        </div>
        <chart class="trace" type="line" options="{{heartOptions}}" datasets="{{heartDatasets}}"></chart>
        <div class="stat-row">
          <div class="stat">
            <text class="stat-label" style="color: {{t.muted}}">HRV</text>
            <text class="stat-value" style="color: {{t.ink}}">{{heart.hrv}}</text>
          </div>
          <div class="stat">
            <text class="stat-label" style="color: {{t.muted}}">RESTING</text>
            <text class="stat-value" style="color: {{t.ink}}">{{heart.resting}}</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Activity -->
    <div class="screen" style="background-color: {{t.bg}}">
      <div class="head">
        <text class="head-label" style="color: {{t.accent}}">Activity</text>
        <text class="head-time" style="color: {{t.ink}}">{{time}}</text>
      </div>
      <stack class="ring-box-small">
        <progress class="arc-small" type="arc" percent="{{stepsPercent}}" style="color: {{t.ink}}; background-color: {{t.track}}; stroke-width: 14px; start-angle: 0; total-angle: 360; center-x: 115px; center-y: 115px; radius: 108px"></progress>
        <div class="ring-center-small">
          <text class="steps-small" style="color: {{t.ink}}">{{stepsLabel}}</text>
          <text class="unit-small" style="color: {{t.muted}}">of {{goalLabel}} steps</text>
        </div>
      </stack>
      <text class="caption" style="color: {{t.ink}}">{{activity.active}} active today</text>
    </div>

    <!-- 5. Coach nudge, with a breathing guide behind "Breathe" -->
    <div class="screen" style="background-color: {{t.bg}}">
      <div class="head">
        <text class="head-label" style="color: {{t.accent}}">Vitaliq</text>
        <text class="head-time" style="color: {{t.ink}}">{{time}}</text>
      </div>
      <div class="nudge-body" if="{{!breathing}}">
        <text class="kicker" style="color: {{t.accent}}">STRESS</text>
        <text class="nudge-text" style="color: {{t.ink}}">{{stress.text}}</text>
        <div class="actions">
          <div class="pill pill-main" style="background-color: {{t.accent}}" onclick="startBreathing">
            <text class="pill-text" style="color: {{t.ink}}">Breathe</text>
          </div>
          <div class="pill pill-alt" style="background-color: {{t.chip}}" onclick="dismissNudge">
            <text class="pill-text" style="color: {{t.ink}}">Later</text>
          </div>
        </div>
      </div>
      <div class="breath-body" if="{{breathing}}">
        <div class="breath-ring" style="border-color: {{t.accent}}">
          <text class="steps" style="color: {{t.ink}}">{{breathCount}}</text>
        </div>
        <text class="caption" style="color: {{t.ink}}">{{breathLabel}}</text>
        <div class="pill pill-alt pill-done" style="background-color: {{t.chip}}" onclick="stopBreathing">
          <text class="pill-text" style="color: {{t.ink}}">Done</text>
        </div>
      </div>
    </div>
  </swiper>
  <div class="dots-bar">
    <div class="dots">
      <div for="{{dots}}" class="dot" style="width: {{$item.w}}px; background-color: {{$item.c}}"></div>
    </div>
  </div>
  </div>
</template>

<script>
import theme from '../../common/theme.js'
import data from '../../common/data.js'

const BREATH_SECONDS = 4
const PAGE_COUNT = 5

function buildDots(active) {
  const dots = []
  for (let i = 0; i < PAGE_COUNT; i++) {
    dots.push(i === active ? { w: 24, c: theme.ink } : { w: 8, c: theme.sleepLight })
  }
  return dots
}

function pad(n) {
  return n < 10 ? '0' + n : '' + n
}

function groupDigits(n) {
  return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
}

export default {
  private: {
    t: theme,
    current: 0,
    dots: buildDots(0),
    time: '--:--',
    breathing: false,
    breathPhase: 'in',
    breathCount: BREATH_SECONDS,
    breathLabel: 'Breathe in',
    readiness: data.readiness,
    sleep: data.sleep,
    heart: data.heart,
    activity: data.activity,
    stress: data.stress,
    sleepBars: data.sleep.bars.map(bar => ({
      h: Math.round(bar.h * 1.3),
      c: bar.k === 'deep' ? theme.accent : bar.k === 'rem' ? theme.sleepRem : theme.sleepLight
    })),
    heartOptions: {
      xAxis: { min: 0, max: data.heart.trace.length - 1, display: false },
      yAxis: { min: Math.min(...data.heart.trace) - 2, max: Math.max(...data.heart.trace) + 2, display: false },
      series: { lineStyle: { width: '4px', smooth: true } }
    },
    heartDatasets: [
      { strokeColor: theme.accent, fillColor: theme.bg, data: data.heart.trace, gradient: false }
    ],
    stepsPercent: Math.round((data.activity.steps / data.activity.goal) * 100),
    stepsLabel: groupDigits(data.activity.steps),
    goalLabel: groupDigits(data.activity.goal)
  },

  onInit() {
    this.updateClock()
    this.clockTimer = setInterval(() => this.updateClock(), 1000)
  },

  onDestroy() {
    clearInterval(this.clockTimer)
    clearInterval(this.breathTimer)
  },

  updateClock() {
    const now = new Date()
    const next = pad(now.getHours()) + ':' + pad(now.getMinutes())
    if (next !== this.time) {
      this.time = next
    }
  },

  setPage(index) {
    this.current = index
    this.dots = buildDots(index)
  },

  onPageChange(e) {
    this.setPage(e.index)
    if (e.index !== 4 && this.breathing) {
      this.stopBreathing()
    }
  },

  dismissNudge() {
    this.setPage(0)
  },

  startBreathing() {
    this.breathing = true
    this.breathPhase = 'in'
    this.breathCount = BREATH_SECONDS
    this.breathLabel = 'Breathe in'
    clearInterval(this.breathTimer)
    this.breathTimer = setInterval(() => this.tickBreath(), 1000)
  },

  tickBreath() {
    if (this.breathCount > 1) {
      this.breathCount = this.breathCount - 1
      return
    }
    this.breathPhase = this.breathPhase === 'in' ? 'out' : 'in'
    this.breathLabel = this.breathPhase === 'in' ? 'Breathe in' : 'Breathe out'
    this.breathCount = BREATH_SECONDS
  },

  stopBreathing() {
    clearInterval(this.breathTimer)
    this.breathing = false
    this.setPage(0)
  }
}
</script>

<style>
